#!/usr/bin/env lua
local argparse = require("argparse")
local Api
Api = require("moonrocks.api").Api
local version = require("moonrocks.version")
local colors = require("ansicolors")
local upload, login
do
  local _obj_0 = require("moonrocks.actions")
  upload, login = _obj_0.upload, _obj_0.login
end
local outdated
outdated = require("moonrocks.outdated").outdated
local parser = argparse("moonrocks", "MoonRocks " .. tostring(version) .. " (using " .. tostring(Api.server) .. ")")
parser:require_command(false)
parser:command_target("action")
parser:flag("--trace", "Show full traceback on errors")
parser:option("--server", "Custom server URL")
parser:flag("--debug", "Enable debug output")
do
  local _with_0 = parser:command("upload", "Pack and upload rockspec/rock to server")
  _with_0:argument("file", "Rockspec or rock file to upload")
  _with_0:flag("--skip-pack", "Skip packing source rock")
  _with_0:flag("--upload-rock", "Force uploading rock for development versions")
  _with_0:option("--code", "Two-factor code (or set $MOONROCKS_TFA_CODE)")
end
parser:command("login", "Set or change API key")
do
  local _with_0 = parser:command("outdated", "Show outdated locked dependencies")
  _with_0:argument("rockspec", "Path to rockspec (auto-detected if omitted)"):args("?")
  _with_0:option("--lock", "Path to luarocks.lock (default: ./luarocks.lock)")
  _with_0:flag("--all", "Show all dependencies, not just outdated ones")
  _with_0:flag("--installed", "Show currently installed versions from luarocks")
end
local args = parser:parse()
local run_action
run_action = function()
  local _exp_0 = args.action
  if "upload" == _exp_0 then
    return upload(args)
  elseif "login" == _exp_0 then
    return login(args)
  elseif "outdated" == _exp_0 then
    return outdated(args)
  else
    return print(parser:get_help())
  end
end
return xpcall(run_action, function(err)
  if not (args.trace) then
    err = err:match("^.-:.-:.(.*)$") or err
  end
  local msg = colors("%{bright red}Error:%{reset} " .. tostring(err))
  if args.trace then
    print(debug.traceback(msg, 2))
  else
    print(msg)
    print(" * Run with --trace to see traceback")
    print(" * Report issues to https://github.com/leafo/moonrocks/issues")
  end
  return os.exit(1)
end)
-- vim: set filetype=lua:
